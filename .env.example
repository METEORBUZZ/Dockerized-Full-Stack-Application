# Application Environment Configuration
# Copy this file to .env and adjust variables as needed for your environment.

# Node & Express Server
NODE_ENV=production
PORT=5000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost:80

# Client Configuration
CLIENT_PORT=3000
VITE_API_URL=/api

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_dev_password
POSTGRES_DB=fullstack_db
POSTGRES_PORT=5432

# Database Connection for Express API (internal Docker network host is "postgres")
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_secure_dev_password
DB_NAME=fullstack_db
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
